# ── Google Ads API Credentials ────────────────────────────────────────────────
# Get these from: https://developers.google.com/google-ads/api/docs/get-started/dev-token

# Optional. Google retired developer tokens on 2026-09-09; leave this unset and
# the header is not sent. Kept only so an older .env still parses.
# GOOGLE_ADS_DEVELOPER_TOKEN=

# From GCP Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_ADS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_client_secret_here

# Generated by running: npx ts-node src/auth-setup.ts
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here

# Your Google Ads Customer ID (the 10-digit number, WITHOUT dashes)
# Example: if your ID is 123-456-7890, enter 1234567890
GOOGLE_ADS_CUSTOMER_ID=1234567890

# The manager account (MCC) the API calls are made through, WITHOUT dashes.
# Required — the server refuses to start without it. For a client account under
# an MCC this is the MCC's own ID, not the client's; they are only the same when
# you are querying the manager account itself.
#
# Put your MCC below. It is an account number, not a credential —
# the secrets that make it usable are the four above.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# ── Hosted (Cloud Run) only ───────────────────────────────────────────────────
# Not used by the stdio server on a laptop. On Cloud Run these come from
# cloudbuild.yaml (PUBLIC_URL) and Secret Manager (OAUTH_SIGNING_KEY), and
# GOOGLE_ADS_REFRESH_TOKEN is not set at all: each operator's token arrives
# through "Sign in with Google" and is stored in Firestore under their Google sub.
# PUBLIC_URL=https://google-ads-mcp-000000000000.us-central1.run.app
# OAUTH_SIGNING_KEY=
# ALLOWED_DOMAINS=example.com,example.org
# ALLOWED_EMAILS=
